server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }

    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        preprocess
        radius_auth
        if (&reply:Reply-Message == "Access accepted") {
            update control {
                Auth-Type := Accept
            }
        }
        else {
            if (!&reply:Reply-Message) {
                update reply {
                    Reply-Message := "Unknown authorization failure"
                }
            }
            reject
        }
    }

    authenticate {
        Auth-Type Accept {
            accept
        }
    }

    accounting {
        radius_acct
        ok
    }
}
